- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='Text to PDU', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('msg_in'))\n\
      \        self.message_port_register_out(pmt.intern('pdu_out'))\n        self.set_msg_handler(pmt.intern('msg_in'),\
      \ self.handle_msg)\n\n    def handle_msg(self, msg):\n        if pmt.is_pair(msg):\n\
      \            msg = pmt.cdr(msg)\n        \n        text = \"\"\n        if pmt.is_symbol(msg):\n\
      \            text = pmt.symbol_to_string(msg)\n        elif pmt.is_string(msg):\n\
      \            text = pmt.string_to_python(msg)\n        else:\n            return\n\
      \n        text += '\\n'\n        \n        # --- PACKET 1: The Real Message\
      \ ---\n        bytes_list = list(text.encode('utf-8'))\n        if len(bytes_list)\
      \ < 1024:\n            bytes_list.extend([32] * (1024 - len(bytes_list)))\n\
      \        \n        pdu_real = pmt.cons(pmt.make_dict(), pmt.init_u8vector(len(bytes_list),\
      \ bytes_list))\n        self.message_port_pub(pmt.intern('pdu_out'), pdu_real)\n\
      \        \n        # --- PACKET 2: The Dummy Flush Packet ---\n        # Fires\
      \ immediately after to push the real packet through the DSP filters.\n     \
      \   # The receiver's .strip() logic automatically ignores this packet.\n   \
      \     flush_list = [32] * 1024 \n        pdu_flush = pmt.cons(pmt.make_dict(),\
      \ pmt.init_u8vector(len(flush_list), flush_list))\n        self.message_port_pub(pmt.intern('pdu_out'),\
      \ pdu_flush)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Text to PDU', 'blk', [], [('msg_in', 'message', 1)], [('pdu_out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 184.0]
    rotation: 0
    state: disabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='PDU to Chat Log', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('pdu_in'))\n\
      \        self.message_port_register_out(pmt.intern('msg_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),\
      \ self.handle_msg)\n        self.chat_history = []\n\n    def handle_msg(self,\
      \ msg):\n        if pmt.is_pair(msg):\n            data = pmt.cdr(msg)\n   \
      \         if pmt.is_u8vector(data):\n                bytes_data = bytes(pmt.u8vector_elements(data))\n\
      \                new_text = bytes_data.decode('utf-8', errors='ignore').strip()\n\
      \                \n                if new_text:\n                    self.chat_history.append(f\"\
      Received: {new_text}\")\n                    if len(self.chat_history) > 10:\n\
      \                        self.chat_history.pop(0)\n                    \n  \
      \                  display_text = \"\\n\".join(self.chat_history)\n        \
      \            self.message_port_pub(pmt.intern('msg_out'), pmt.intern(display_text))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('PDU to Chat Log', 'blk', [], [('pdu_in', 'message', 1)], [('msg_out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [944, 1728.0]
    rotation: 0
    state: disabled
