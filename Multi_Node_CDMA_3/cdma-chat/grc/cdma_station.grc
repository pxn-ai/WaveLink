  id: iio_fmcomms2_source
  parameters:
    type: fc32
    uri: uri
    frequency: int(center_freq)
    samplerate: int(samp_rate)
    bandwidth: int(samp_rate)
    buffer_size: '32768'
    rx1_en: 'True'
    rx2_en: 'False'
    gain1: '''manual'''
    manual_gain1: rx_gain
    quadrature: 'True'
    rfdc: 'True'
    bbdc: 'True'
    len_tag_key: ''''''
