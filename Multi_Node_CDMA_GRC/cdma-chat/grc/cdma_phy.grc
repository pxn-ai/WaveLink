options:
  parameters:
    author: EN2130 group
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: DS-CDMA BPSK/QPSK/16-QAM physical layer of one station
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: cdma_phy
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CDMA Chat - physical layer (ANTSDR E200)
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: note_about
  id: note
  parameters:
    note: 'PHYSICAL LAYER of one CDMA Chat station. The chat app compiles this file with grcc, runs it and attaches its link layer to the ''MAC -> PHY'' and ''PHY

      -> MAC'' blocks. Every station uses the same file with its own Node ID (1-4 = its Gold code). ANTSDR E200 with the Pluto (libiio) firmware, carrier 2.5

      GHz, DS-CDMA with 31-chip Gold codes, payload BPSK, QPSK or 16-QAM chosen per frame by the link layer.'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 90
    rotation: 0
    state: enabled
- name: node_id
  id: parameter
  parameters:
    label: Node ID (= Gold code)
    type: intx
    value: '1'
    short_id: i
    hide: none
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 170
    rotation: 0
    state: enabled
- name: uri
  id: parameter
  parameters:
    label: ANTSDR URI
    type: str
    value: ip:192.168.1.10
    short_id: u
    hide: none
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 248
    - 170
    rotation: 0
    state: enabled
- name: center_freq
  id: parameter
  parameters:
    label: Carrier (Hz)
    type: eng_float
    value: 2.5e9
    short_id: f
    hide: none
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 488
    - 170
    rotation: 0
    state: enabled
- name: rx_gain
