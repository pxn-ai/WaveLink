- name: despreader
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA Despreader\n\nInput: received samples after the RRC matched filter.\nFor this station's Gold code and the broadcast code it\n  1. correlates with the code-specific preamble (differential detector: works\n     with carrier frequency offset) -> burst start, timing, coarse CFO\n  2. removes the CFO, despreads (x code, sum over 31 chips) with fractional-delay\n     timing and an early-late DLL that follows the clock offset between radios\n  3. decodes the BPSK header (length, modulation, CRC-8)\n  4. tracks the carrier phase over the payload (decision-directed loop)\nand outputs one PDU per burst: the despread payload symbols, normalised to the\nunit-energy constellation, with metadata mod / code / snr_db / esn0_db / cfo_hz.\nThe stock Constellation Decoder blocks downstream make the bit decisions.\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the cdmachat package importable (this file\
      \ is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here, \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand, \"cdmachat\")):\n            cand = os.path.abspath(cand)\n            if cand not in sys.path:\n                sys.path.insert(0, cand)\n            return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy import register\n            register(node_id, role, obj)\n    except ImportError:\n        pass                     # opened in GNU Radio Companion outside the project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self, node_id=1, samp_rate=4e6, sps=2, gold_degree=5, preamble_bits=48,\n                 max_payload=1024):\n\
      \        gr.sync_block.__init__(self, name=\"CDMA Despreader\", in_sig=[np.complex64], out_sig=None)\n        self.node_id = int(node_id)\n        self.port = pmt.intern(\"pdus\")\n        self.message_port_register_out(self.port)\n        self.set_output_multiple(16384)        # hand samples over in big chunks (less overhead)\n        self.core = None\n        try:\n            if _project():\n                from cdmachat.grc_phy import DespreaderCore, phy_config\n                cfg = phy_config(samp_rate, sps, gold_degree, preamble_bits, max_payload)\n                self.core = DespreaderCore(cfg, self.node_id, self._publish)\n                _register(self.node_id, \"despreader\", self.core)\n        except ImportError:\n            pass\n\n    def _publish(self, f):\n        mod = \"bpsk\" if f.mod in (\"bpsk\", \"bpskc\") else f.mod\n        meta = pmt.make_dict()\n        for k, v in ((\"mod\", pmt.intern(mod)), (\"code\", pmt.from_long(int(f.code_idx))),\n               \
      \      (\"snr_db\", pmt.from_double(float(f.snr_db))),\n                     (\"esn0_db\", pmt.from_double(float(f.esn0_db))),\n                     (\"cfo_hz\", pmt.from_double(float(f.cfo_hz))),\n                     (\"metric\", pmt.from_double(float(f.metric)))):\n            meta = pmt.dict_add(meta, pmt.intern(k), v)\n        s = f.symbols\n        self.message_port_pub(self.port, pmt.cons(meta, pmt.init_c32vector(len(s), s.tolist())))\n\n    def start(self):\n        if self.core is not None:\n            self.core.start()\n        return True\n\n    def stop(self):\n        if self.core is not None:\n            self.core.stop()\n        return True\n\n    def work(self, input_items, output_items):\n        if self.core is not None:\n            self.core.push(input_items[0])\n        return len(input_items[0])\n"
    node_id: node_id
    samp_rate: samp_rate
    sps: sps
    gold_degree: gold_degree
    preamble_bits: preamble_bits
    max_payload: max_payload
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 548
    - 2220
    rotation: 0
    state: enabled
