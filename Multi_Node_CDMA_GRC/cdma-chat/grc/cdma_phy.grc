- name: combiner
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA Burst Combiner\n\nOne input per code lane (chips of complete bursts, tagged with 'packet_len').\nBursts on different codes are added together sample by sample (several links\nactive at once on one carrier = CDMA); bursts on the same code follow each other.\nWhen no lane is sending, zeros are output so the radio always gets a continuous\nstream (the stock 'PDU to Stream' block stops instead, which starves the Pluto sink).\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the cdmachat package importable (this file is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here, \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand, \"cdmachat\")):\n      \
      \      cand = os.path.abspath(cand)\n            if cand not in sys.path:\n                sys.path.insert(0, cand)\n            return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy import register\n            register(node_id, role, obj)\n    except ImportError:\n        pass                     # opened in GNU Radio Companion outside the project: ports only\n\nimport collections\n\n\nclass blk(gr.basic_block):\n    def __init__(self, node_id=1, codes=(0, 1, 2, 3, 4), chip_rate=2e6, samp_rate=4e6,\n                 tx_buffer=131072):\n        self.codes = [int(c) for c in codes]\n        gr.basic_block.__init__(self, name=\"CDMA Burst Combiner\",\n                                in_sig=[np.complex64] * len(self.codes), out_sig=[np.complex64])\n        self.node_id = int(node_id)\n        self.len_key = pmt.intern(\"packet_len\")\n        self.lens = [collections.deque() for\
      \ _ in self.codes]\n        self.bufs = [collections.deque() for _ in self.codes]\n        self.have = [0] * len(self.codes)\n        # produce in large chunks: each Python call has a fixed overhead, so fewer,\n        # bigger calls keep the CPU load low (costs <= 4 ms of TX latency at 2 Mchip/s)\n        self.set_output_multiple(8192)\n        self.core = None\n        try:\n            if _project():\n                from cdmachat.grc_phy import CombinerCore\n                self.core = CombinerCore(float(chip_rate), int(tx_buffer), float(samp_rate))\n                _register(self.node_id, \"combiner\", self.core)\n        except ImportError:\n            pass\n\n    def forecast(self, noutput_items, ninputs):\n        return [0] * ninputs                  # run even when every lane is idle\n\n    def _take(self, i, n):\n        parts, need = [], n\n        while need:\n            b = self.bufs[i][0]\n            if b.size <= need:\n                parts.append(self.bufs[i].popleft())\n\
      \                need -= b.size\n            else:\n                parts.append(b[:need])\n                self.bufs[i][0] = b[need:]\n                need = 0\n        self.have[i] -= n\n        return np.concatenate(parts)\n\n    def general_work(self, input_items, output_items):\n        for i, x in enumerate(input_items):\n            n = len(x)\n            if not n:\n                continue\n            for t in self.get_tags_in_window(i, 0, n):\n                if pmt.eq(t.key, self.len_key):\n                    self.lens[i].append(pmt.to_long(t.value))\n            self.bufs[i].append(np.array(x, dtype=np.complex64))\n            self.have[i] += n\n            self.consume(i, n)\n            # only complete bursts are scheduled, so a burst is never cut by a gap\n            while self.lens[i] and self.have[i] >= self.lens[i][0]:\n                burst = self._take(i, self.lens[i].popleft())\n                if self.core is not None:\n                    self.core.push(self.codes[i],\
      \ burst)\n        out = output_items[0]\n        if self.core is None:\n            out[:] = 0\n        else:\n            self.core.read_into(out)\n        return len(out)\n"
    node_id: node_id
    codes: (0, 1, 2, 3, 4)
    chip_rate: chip_rate
    samp_rate: samp_rate
    tx_buffer: tx_buffer
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1928
    - 1420
    rotation: 0
    state: enabled
