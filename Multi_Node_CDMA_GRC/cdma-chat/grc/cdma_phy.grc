    - 290
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: firdes.root_raised_cosine(sps, sps, 1.0, rolloff, 8 * sps + 1)
    comment: root-raised-cosine chip pulse
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 400
    rotation: 0
    state: enabled
- name: tx_scale
  id: variable
  parameters:
    value: 0.25 / (sum(t * t for t in rrc_taps) / sps) ** 0.5
    comment: 'RMS 0.25 per code lane:

      headroom for 16-QAM peaks

      and several lanes at once'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 468
    - 400
    rotation: 0
    state: enabled
