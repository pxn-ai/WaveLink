- name: mac_rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nPHY -> MAC (to app)\n\nExit point of the physical layer: frames that passed the CRC-32 check, with the\nreceiver's metadata (code, modulation, SNR, carrier offset).  The chat\napplication's link layer installs a handler here; when the flowgraph is run on\nits own (e.g. from GNU Radio Companion) received frames are just printed.\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the cdmachat package importable (this file is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here, \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand, \"cdmachat\")):\n            cand = os.path.abspath(cand)\n            if cand not in sys.path:\n                sys.path.insert(0,\
      \ cand)\n            return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy import register\n            register(node_id, role, obj)\n    except ImportError:\n        pass                     # opened in GNU Radio Companion outside the project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self, node_id=1):\n        gr.sync_block.__init__(self, name=\"PHY -> MAC (to app)\", in_sig=None, out_sig=None)\n        self.node_id = int(node_id)\n        self.port = pmt.intern(\"pdus\")\n        self.message_port_register_in(self.port)\n        self.set_msg_handler(self.port, self.handle)\n        self.handler = None\n        _register(self.node_id, \"mac_rx\", self)\n\n    def handle(self, msg):\n        meta = pmt.to_python(pmt.car(msg)) or {}\n        data = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        if self.handler is not None:\n            self.handler(meta,\
      \ data)\n        else:\n            print(f\"[node {self.node_id}] rx {len(data)} B  mod={meta.get('mod')} \"\n                  f\"code={meta.get('code')} Es/N0={meta.get('esn0_db', 0):.1f} dB\", flush=True)\n"
    node_id: node_id
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2558
    - 2400
    rotation: 0
    state: enabled
