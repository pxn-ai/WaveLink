- name: tx_scale
  id: variable
  parameters:
    comment: 'RMS 0.25 per code lane:

      headroom for 16-QAM peaks

      and several lanes at once'
    value: 0.25 / (sum(t * t for t in rrc_taps) / sps) ** 0.5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [468, 400]
    rotation: 0
    state: enabled
