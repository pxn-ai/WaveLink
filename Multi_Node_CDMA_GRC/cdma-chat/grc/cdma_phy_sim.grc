- name: n1_combiner
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA Burst Combiner\n\nOne input per code lane (chips of\
      \ complete bursts, tagged with 'packet_len').\nBursts on different codes are\
      \ added together sample by sample (several links\nactive at once on one carrier\
      \ = CDMA); bursts on the same code follow each other.\nWhen no lane is sending,\
      \ zeros are output so the radio always gets a continuous\nstream (the stock\
      \ 'PDU to Stream' block stops instead, which starves the Pluto sink).\n\"\"\"\
      \nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\n\ndef _project():\n    \"\"\"Make the cdmachat package importable (this\
      \ file is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"\
      __file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here,\
      \ \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(),\
      \ os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand,\
      \ \"cdmachat\")):\n            cand = os.path.abspath(cand)\n            if\
      \ cand not in sys.path:\n                sys.path.insert(0, cand)\n        \
      \    return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id,\
      \ role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy\
      \ import register\n            register(node_id, role, obj)\n    except ImportError:\n\
      \        pass                     # opened in GNU Radio Companion outside the\
      \ project: ports only\n\nimport collections\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, node_id=1, codes=(0, 1, 2, 3, 4), chip_rate=2e6, samp_rate=4e6,\n\
      \                 tx_buffer=131072):\n        self.codes = [int(c) for c in\
      \ codes]\n        gr.basic_block.__init__(self, name=\"CDMA Burst Combiner\"\
      ,\n                                in_sig=[np.complex64] * len(self.codes),\
      \ out_sig=[np.complex64])\n        self.node_id = int(node_id)\n        self.len_key\
      \ = pmt.intern(\"packet_len\")\n        self.lens = [collections.deque() for\
      \ _ in self.codes]\n        self.bufs = [collections.deque() for _ in self.codes]\n\
      \        self.have = [0] * len(self.codes)\n        # produce in large chunks:\
      \ each Python call has a fixed overhead, so fewer,\n        # bigger calls keep\
      \ the CPU load low (costs <= 4 ms of TX latency at 2 Mchip/s)\n        self.set_output_multiple(8192)\n\
      \        self.core = None\n        try:\n            if _project():\n      \
      \          from cdmachat.grc_phy import CombinerCore\n                self.core\
      \ = CombinerCore(float(chip_rate), int(tx_buffer), float(samp_rate))\n     \
      \           _register(self.node_id, \"combiner\", self.core)\n        except\
      \ ImportError:\n            pass\n\n    def forecast(self, noutput_items, ninputs):\n\
      \        return [0] * ninputs                  # run even when every lane is\
      \ idle\n\n    def _take(self, i, n):\n        parts, need = [], n\n        while\
      \ need:\n            b = self.bufs[i][0]\n            if b.size <= need:\n \
      \               parts.append(self.bufs[i].popleft())\n                need -=\
      \ b.size\n            else:\n                parts.append(b[:need])\n      \
      \          self.bufs[i][0] = b[need:]\n                need = 0\n        self.have[i]\
      \ -= n\n        return np.concatenate(parts)\n\n    def general_work(self, input_items,\
      \ output_items):\n        for i, x in enumerate(input_items):\n            n\
      \ = len(x)\n            if not n:\n                continue\n            for\
      \ t in self.get_tags_in_window(i, 0, n):\n                if pmt.eq(t.key, self.len_key):\n\
      \                    self.lens[i].append(pmt.to_long(t.value))\n           \
      \ self.bufs[i].append(np.array(x, dtype=np.complex64))\n            self.have[i]\
      \ += n\n            self.consume(i, n)\n            # only complete bursts are\
      \ scheduled, so a burst is never cut by a gap\n            while self.lens[i]\
      \ and self.have[i] >= self.lens[i][0]:\n                burst = self._take(i,\
      \ self.lens[i].popleft())\n                if self.core is not None:\n     \
      \               self.core.push(self.codes[i], burst)\n        out = output_items[0]\n\
      \        if self.core is None:\n            out[:] = 0\n        else:\n    \
      \        self.core.read_into(out)\n        return len(out)\n"
    affinity: ''
    alias: ''
    chip_rate: chip_rate
    codes: (0, 1, 2, 3, 4)
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    node_id: '1'
    samp_rate: samp_rate
    tx_buffer: tx_buffer
  states:
    _io_cache: ('CDMA Burst Combiner', 'blk', [('node_id', '1'), ('codes', '(0, 1,
      2, 3, 4)'), ('chip_rate', '2000000.0'), ('samp_rate', '4000000.0'), ('tx_buffer',
      '131072')], [('0', 'complex', 1), ('1', 'complex', 1), ('2', 'complex', 1),
      ('3', 'complex', 1), ('4', 'complex', 1)], [('0', 'complex', 1)], '', ['codes',
      'node_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1928, 1530]
    rotation: 0
    state: enabled
- name: n1_despreader
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA Despreader\n\nInput: received samples after the RRC\
      \ matched filter.\nFor this station's Gold code and the broadcast code it\n\
      \  1. correlates with the code-specific preamble (differential detector: works\n\
      \     with carrier frequency offset) -> burst start, timing, coarse CFO\n  2.\
      \ removes the CFO, despreads (x code, sum over 31 chips) with fractional-delay\n\
      \     timing and an early-late DLL that follows the clock offset between radios\n\
      \  3. decodes the BPSK header (length, modulation, CRC-8)\n  4. tracks the carrier\
      \ phase over the payload (decision-directed loop)\nand outputs one PDU per burst:\
      \ the despread payload symbols, normalised to the\nunit-energy constellation,\
      \ with metadata mod / code / snr_db / esn0_db / cfo_hz.\nThe stock Constellation\
      \ Decoder blocks downstream make the bit decisions.\n\"\"\"\nimport os\nimport\
      \ sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n\
      \    \"\"\"Make the cdmachat package importable (this file is generated into\
      \ grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"\
      __file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here,\
      \ \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(),\
      \ os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand,\
      \ \"cdmachat\")):\n            cand = os.path.abspath(cand)\n            if\
      \ cand not in sys.path:\n                sys.path.insert(0, cand)\n        \
      \    return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id,\
      \ role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy\
      \ import register\n            register(node_id, role, obj)\n    except ImportError:\n\
      \        pass                     # opened in GNU Radio Companion outside the\
      \ project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ node_id=1, samp_rate=4e6, sps=2, gold_degree=5, preamble_bits=48,\n      \
      \           max_payload=1024):\n        gr.sync_block.__init__(self, name=\"\
      CDMA Despreader\", in_sig=[np.complex64], out_sig=None)\n        self.node_id\
      \ = int(node_id)\n        self.port = pmt.intern(\"pdus\")\n        self.message_port_register_out(self.port)\n\
      \        self.set_output_multiple(16384)        # hand samples over in big chunks\
      \ (less overhead)\n        self.core = None\n        try:\n            if _project():\n\
      \                from cdmachat.grc_phy import DespreaderCore, phy_config\n \
      \               cfg = phy_config(samp_rate, sps, gold_degree, preamble_bits,\
      \ max_payload)\n                self.core = DespreaderCore(cfg, self.node_id,\
      \ self._publish)\n                _register(self.node_id, \"despreader\", self.core)\n\
      \        except ImportError:\n            pass\n\n    def _publish(self, f):\n\
      \        mod = \"bpsk\" if f.mod in (\"bpsk\", \"bpskc\") else f.mod\n     \
      \   meta = pmt.make_dict()\n        for k, v in ((\"mod\", pmt.intern(mod)),\
      \ (\"code\", pmt.from_long(int(f.code_idx))),\n                     (\"snr_db\"\
      , pmt.from_double(float(f.snr_db))),\n                     (\"esn0_db\", pmt.from_double(float(f.esn0_db))),\n\
      \                     (\"cfo_hz\", pmt.from_double(float(f.cfo_hz))),\n    \
      \                 (\"metric\", pmt.from_double(float(f.metric)))):\n       \
      \     meta = pmt.dict_add(meta, pmt.intern(k), v)\n        s = f.symbols\n \
      \       self.message_port_pub(self.port, pmt.cons(meta, pmt.init_c32vector(len(s),\
      \ s.tolist())))\n\n    def start(self):\n        if self.core is not None:\n\
      \            self.core.start()\n        return True\n\n    def stop(self):\n\
      \        if self.core is not None:\n            self.core.stop()\n        return\
      \ True\n\n    def work(self, input_items, output_items):\n        if self.core\
      \ is not None:\n            self.core.push(input_items[0])\n        return len(input_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    gold_degree: gold_degree
    max_payload: max_payload
    maxoutbuf: '0'
    minoutbuf: '0'
    node_id: '1'
    preamble_bits: preamble_bits
    samp_rate: samp_rate
    sps: sps
  states:
    _io_cache: ('CDMA Despreader', 'blk', [('node_id', '1'), ('samp_rate', '4000000.0'),
      ('sps', '2'), ('gold_degree', '5'), ('preamble_bits', '48'), ('max_payload',
      '1024')], [('0', 'complex', 1)], [('pdus', 'message', 1)], '', ['node_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [548, 2330]
    rotation: 0
    state: enabled
- name: n1_framer
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA PHY Framer\n\nBuilds one burst per PDU and outputs\
      \ it as constellation *indices* (one byte per\nsymbol) for the Chunks-to-Symbols\
      \ blocks of the code lanes:\n\n  preamble   48 known BPSK symbols, different\
      \ for every Gold code (burst detection,\n             timing, carrier phase\
      \ and frequency estimation at the receiver)\n  header     24 BPSK symbols, differentially\
      \ coded: 14-bit length, 2-bit modulation, CRC-8\n  payload    MAC frame + CRC-32,\
      \ Gray-mapped to BPSK (index 0-1), QPSK (2-5)\n             or 16-QAM (6-21)\
      \ of the combined symbol table\n\nOutput metadata 'code' selects the lane (spreading\
      \ code) downstream.\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the cdmachat\
      \ package importable (this file is generated into grc/ or build/grc/).\"\"\"\
      \n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(),\
      \ \"x\"))))\n    for cand in (here, os.path.join(here, \"..\"), os.path.join(here,\
      \ \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(),\
      \ \"..\")):\n        if os.path.isdir(os.path.join(cand, \"cdmachat\")):\n \
      \           cand = os.path.abspath(cand)\n            if cand not in sys.path:\n\
      \                sys.path.insert(0, cand)\n            return True\n    return\
      \ \"cdmachat\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n\
      \        if _project():\n            from cdmachat.grc_phy import register\n\
      \            register(node_id, role, obj)\n    except ImportError:\n       \
      \ pass                     # opened in GNU Radio Companion outside the project:\
      \ ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self, gold_degree=5,\
      \ preamble_bits=48, max_payload=1024):\n        gr.sync_block.__init__(self,\
      \ name=\"CDMA PHY Framer\", in_sig=None, out_sig=None)\n        self.args =\
      \ (int(gold_degree), int(preamble_bits), int(max_payload))\n        self.port_in,\
      \ self.port_out = pmt.intern(\"pdus\"), pmt.intern(\"pdus\")\n        self.message_port_register_in(self.port_in)\n\
      \        self.message_port_register_out(self.port_out)\n        self.set_msg_handler(self.port_in,\
      \ self.handle)\n        self.core = None\n\n    def start(self):\n        _project()\n\
      \        from cdmachat.grc_phy import FramerCore, phy_config\n        g, k,\
      \ m = self.args\n        self.core = FramerCore(phy_config(4e6, 2, g, k, m))\n\
      \        return True\n\n    def handle(self, msg):\n        if self.core is\
      \ None:\n            self.start()\n        meta, vec = pmt.car(msg), pmt.cdr(msg)\n\
      \        code = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"code\"), pmt.from_long(0)))\n\
      \        mod = pmt.symbol_to_string(pmt.dict_ref(meta, pmt.intern(\"mod\"),\
      \ pmt.intern(\"bpsk\")))\n        idx = self.core.indices(bytes(pmt.u8vector_elements(vec)),\
      \ code, mod)\n        out = pmt.dict_add(pmt.make_dict(), pmt.intern(\"code\"\
      ), pmt.from_long(code))\n        self.message_port_pub(self.port_out, pmt.cons(out,\
      \ pmt.init_u8vector(len(idx), idx.tolist())))\n"
    affinity: ''
    alias: ''
    comment: ''
    gold_degree: gold_degree
    max_payload: max_payload
    maxoutbuf: '0'
    minoutbuf: '0'
    preamble_bits: preamble_bits
  states:
    _io_cache: ('CDMA PHY Framer', 'blk', [('gold_degree', '5'), ('preamble_bits',
      '48'), ('max_payload', '1024')], [('pdus', 'message', 1)], [('pdus', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1570]
    rotation: 0
    state: enabled
