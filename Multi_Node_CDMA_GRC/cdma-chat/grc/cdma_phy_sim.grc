- name: n3_mac_tx
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nMAC -> PHY (from app)\n\nEntry point of the physical layer.\
      \  The chat application's link layer calls\nsubmit(frame, code, mod) on this\
      \ block; it publishes the MAC frame as a PDU\nwhose metadata says which Gold\
      \ code to spread it with (= destination station,\n0 = broadcast) and which payload\
      \ modulation to use (bpsk | qpsk | 16qam).\n\"\"\"\nimport os\nimport sys\n\
      import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n\
      \    \"\"\"Make the cdmachat package importable (this file is generated into\
      \ grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"\
      __file__\", os.path.join(os.getcwd(), \"x\"))))\n    for cand in (here, os.path.join(here,\
      \ \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(),\
      \ os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand,\
      \ \"cdmachat\")):\n            cand = os.path.abspath(cand)\n            if\
      \ cand not in sys.path:\n                sys.path.insert(0, cand)\n        \
      \    return True\n    return \"cdmachat\" in sys.modules\n\n\ndef _register(node_id,\
      \ role, obj):\n    try:\n        if _project():\n            from cdmachat.grc_phy\
      \ import register\n            register(node_id, role, obj)\n    except ImportError:\n\
      \        pass                     # opened in GNU Radio Companion outside the\
      \ project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ node_id=1):\n        gr.sync_block.__init__(self, name=\"MAC -> PHY (from\
      \ app)\", in_sig=None, out_sig=None)\n        self.node_id = int(node_id)\n\
      \        self.port = pmt.intern(\"pdus\")\n        self.message_port_register_out(self.port)\n\
      \        _register(self.node_id, \"mac_tx\", self)\n\n    def submit(self, frame,\
      \ code, mod):\n        meta = pmt.make_dict()\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"code\"), pmt.from_long(int(code)))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"mod\"), pmt.intern(str(mod)))\n        self.message_port_pub(self.port,\
      \ pmt.cons(meta, pmt.init_u8vector(len(frame), list(frame))))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    node_id: '3'
  states:
    _io_cache: ('MAC -> PHY (from app)', 'blk', [('node_id', '1')], [], [('pdus',
      'message', 1)], '', ['node_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 5480]
    rotation: 0
    state: enabled
- name: n3_note_rx
  id: note
  parameters:
    alias: ''
    comment: ''
    note: 'RECEIVER: ANTSDR -> RRC matched filter -> CDMA Despreader (preamble correlation
      for this node''s code and the broadcast

      code, carrier-offset estimate, DLL timing, despreading, BPSK header, carrier
      tracking) -> one branch per modulation:

      Constellation Decoder -> Repack Bits -> CRC-32 check (bad frames dropped) ->
      MAC'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 6680]
    rotation: 0
    state: enabled
- name: n3_note_tx
  id: note
  parameters:
    alias: ''
    comment: ''
    note: 'TRANSMITTER: MAC frame -> CRC-32 -> CDMA PHY Framer (48 preamble symbols,
      BPSK header, payload as constellation indices)

      -> one lane per Gold code: Chunks to Symbols (BPSK / QPSK / 16-QAM), Repeat
      x31 and Multiply by the code = spreading ->

      Burst Combiner (adds the lanes, zero-fills) -> RRC pulse shaping -> ANTSDR at
      2.5 GHz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 5370]
    rotation: 0
    state: enabled
