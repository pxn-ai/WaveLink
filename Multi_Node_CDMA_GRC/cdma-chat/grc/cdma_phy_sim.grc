  parameters:
    alias: ''
    comment: ''
    note: 'Three complete station PHYs (nodes 1-3) sharing one simulated 2.5 GHz channel:
      their transmit signals are added, passed through a Channel Model (noise

      + carrier offset) and fed to every receiver. Run with:  python3 -m cdmachat
      grc-sim   (web UIs on ports 8081-8083). Sample rate is 1 MS/s because all

      three PHYs share one Python process.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 90]
    rotation: 0
    state: enabled
