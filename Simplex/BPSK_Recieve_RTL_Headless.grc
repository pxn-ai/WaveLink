options:
  parameters:
    author: Barry Duggan
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: BPSK_Recieve_RTL_Headless
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK_Recieve_RTL_Headless
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [24, 16.0]
    rotation: 0
    state: enabled

blocks:
  - name: constel
    id: variable_constellation
    parameters:
      comment: ''
      const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
      dims: '1'
      normalization: digital.constellation.AMPLITUDE_NORMALIZATION
      npwr: '1.0'
      precision: '8'
      rot_sym: '4'
      soft_dec_lut: None
      sym_map: '[0, 1, 3, 2]'
      type: bpsk
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [640, 12.0]
      rotation: 0
      state: enabled
  - name: frequency
    id: variable
    parameters:
      comment: ''
      value: 905.2e6
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [464, 20.0]
      rotation: 0
      state: true
  - name: rfGain
    id: variable
    parameters:
      comment: ''
      value: '44.5'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [872, 8.0]
      rotation: 0
      state: enabled
  - name: samp_rate
    id: variable
    parameters:
      comment: ''
      value: '2000000'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [216, 12.0]
      rotation: 0
      state: enabled
  - name: sps
    id: variable
    parameters:
      comment: ''
      value: '4'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [336, 12.0]
      rotation: 0
      state: enabled
  - name: blocks_file_sink_0
    id: blocks_file_sink
    parameters:
      affinity: ''
      alias: ''
      append: 'False'
      comment: ''
      file: bpsk_receive.txt
      type: byte
      unbuffered: 'True'
      vlen: '1'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [872, 828.0]
      rotation: 0
      state: enabled
  - name: blocks_message_debug_0
    id: blocks_message_debug
    parameters:
      affinity: ''
      alias: ''
      comment: ''
      en_uvec: 'True'
      log_level: info
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1320, 720.0]
      rotation: 0
      state: enabled
  - name: blocks_repack_bits_bb_1
    id: blocks_repack_bits_bb
    parameters:
      affinity: ''
      alias: ''
      align_output: 'True'
      comment: ''
      endianness: gr.GR_MSB_FIRST
      k: '1'
      l: '8'
      len_tag_key: packet_len
      maxoutbuf: '0'
      minoutbuf: '0'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [304, 732.0]
      rotation: 0
      state: enabled
  - name: digital_constellation_decoder_cb_1
    id: digital_constellation_decoder_cb
    parameters:
      affinity: ''
      alias: ''
      comment: ''
      constellation: constel
      maxoutbuf: '0'
      minoutbuf: '0'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [352, 576.0]
      rotation: 0
      state: enabled
  - name: digital_correlate_access_code_xx_ts_0
    id: digital_correlate_access_code_xx_ts
    parameters:
      access_code: digital.packet_utils.default_access_code
      affinity: ''
      alias: ''
      comment: ''
      maxoutbuf: '0'
      minoutbuf: '0'
      tagname: packet_len
      threshold: '0'
      type: byte
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [944, 556.0]
      rotation: 0
      state: enabled
  - name: digital_costas_loop_cc_0
    id: digital_costas_loop_cc
    parameters:
      affinity: ''
      alias: ''
      comment: ''
      maxoutbuf: '0'
      minoutbuf: '0'
      order: len(constel.points())
      use_snr: 'False'
      w: 3.14/100
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1040, 304.0]
      rotation: 0
      state: enabled
  - name: digital_crc32_bb_1
    id: digital_crc32_bb
    parameters:
      affinity: ''
      alias: ''
      check: 'True'
      comment: ''
      lengthtagname: packet_len
      maxoutbuf: '0'
      minoutbuf: '0'
      packed: 'True'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [568, 724.0]
      rotation: 0
      state: enabled
  - name: digital_diff_decoder_bb_0
    id: digital_diff_decoder_bb
    parameters:
      affinity: ''
      alias: ''
      coding: digital.DIFF_DIFFERENTIAL
      comment: ''
      maxoutbuf: '0'
      minoutbuf: '0'
      modulus: len(constel.points())
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [648, 564.0]
      rotation: 0
      state: enabled
  - name: digital_symbol_sync_xx_0
    id: digital_symbol_sync_xx
    parameters:
      affinity: ''
      alias: ''
      comment: ''
      constellation: constel.base()
      damping: '1.0'
      loop_bw: '0.045'
      max_dev: '1.5'
      maxoutbuf: '0'
      minoutbuf: '0'
      nfilters: '32'
      osps: '1'
      pfb_mf_taps: '[]'
      resamp_type: digital.IR_MMSE_8TAP
      sps: sps
      ted_gain: '0.1'
      ted_type: digital.TED_SIGNAL_TIMES_SLOPE_ML
      type: cc
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [608, 308.0]
      rotation: 0
      state: enabled
  - name: epy_block_0
    id: epy_block
    parameters:
      _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass
        blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self,
        name='PDU to Chat Log', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('pdu_in'))\n\
        \        self.message_port_register_out(pmt.intern('msg_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),
        self.handle_msg)\n        self.chat_history = []\n\n    def handle_msg(self,
        msg):\n        if pmt.is_pair(msg):\n            data = pmt.cdr(msg)\n   \
        \         if pmt.is_u8vector(data):\n                bytes_data = bytes(pmt.u8vector_elements(data))\n\
        \                new_text = bytes_data.decode('utf-8', errors='ignore').strip()\n\
        \                \n                if new_text:\n                    self.chat_history.append(f\"\
        Received: {new_text}\")\n                    if len(self.chat_history) > 10:\n\
        \                        self.chat_history.pop(0)\n                    \n\
        \                    display_text = \"\\n\".join(self.chat_history)\n    \
        \                self.message_port_pub(pmt.intern('msg_out'), pmt.intern(display_text))\n"
      affinity: ''
      alias: ''
      comment: ''
      maxoutbuf: '0'
      minoutbuf: '0'
    states:
      _io_cache: ('PDU to Chat Log', 'blk', [], [('pdu_in', 'message', 1)], 
        [('msg_out', 'message', 1)], '', [])
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1120, 896.0]
      rotation: 0
      state: enabled
  - name: filter_fft_rrc_filter_0
    id: filter_fft_rrc_filter
    parameters:
      affinity: ''
      alias: ''
      alpha: '0.35'
      comment: ''
      decim: '1'
      gain: '1'
      maxoutbuf: '0'
      minoutbuf: '0'
      ntaps: 11*sps
      nthreads: '1'
      samp_rate: samp_rate
      sym_rate: samp_rate/sps
      type: ccc
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [304, 304.0]
      rotation: 0
      state: enabled
  - name: pdu_tagged_stream_to_pdu_0
    id: pdu_tagged_stream_to_pdu
    parameters:
      affinity: ''
      alias: ''
      comment: ''
      maxoutbuf: '0'
      minoutbuf: '0'
      tag: packet_len
      type: byte
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [960, 744.0]
      rotation: 0
      state: enabled
  - name: zeromq_push_msg_sink_0
    id: zeromq_push_msg_sink
    parameters:
      address: '"tcp://127.0.0.1:5002"'
      affinity: ''
      alias: ''
      bind: 'False'
      comment: ''
      timeout: '100'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1336, 872.0]
      rotation: 0
      state: enabled
  - name: soapy_rtlsdr_source_0
    id: soapy_rtlsdr_source
    parameters:
      affinity: ''
      agc: 'False'
      alias: ''
      bias: 'False'
      bufflen: '16384'
      center_freq: frequency
      comment: ''
      dev_args: ''
      freq_correction: '0'
      gain: rfGain
      maxoutbuf: '0'
      minoutbuf: '0'
      samp_rate: samp_rate
      type: fc32
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [72, 328.0]
      rotation: 0
      state: disabled
  - name: virtual_sink_3
    id: virtual_sink
    parameters:
      alias: ''
      comment: ''
      stream_id: recovery
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1336, 216.0]
      rotation: 0
      state: enabled
  - name: virtual_sink_4
    id: virtual_sink
    parameters:
      alias: ''
      comment: ''
      stream_id: payload
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [1312, 576.0]
      rotation: 0
      state: enabled
  - name: virtual_source_2
    id: virtual_source
    parameters:
      alias: ''
      comment: ''
      stream_id: recovery
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [88, 576.0]
      rotation: 0
      state: enabled
  - name: virtual_source_3
    id: virtual_source
    parameters:
      alias: ''
      comment: ''
      stream_id: payload
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [80, 744.0]
      rotation: 0
      state: enabled
  - name: zeromq_sub_source_0
    id: zeromq_sub_source
    parameters:
      address: '"tcp://192.168.1.100:5555"'
      affinity: ''
      alias: ''
      bind: 'False'
      comment: ''
      hwm: '-1'
      key: ''
      maxoutbuf: '0'
      minoutbuf: '0'
      pass_tags: 'False'
      timeout: '100'
      type: complex
      vlen: '1'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate: [64, 176.0]
      rotation: 0
      state: enabled

  - name: xmlrpc_server_0
    id: xmlrpc_server
    parameters:
      addr: 127.0.0.1
      alias: ''
      comment: ''
      port: '8082'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate:
        - 200
        - 200.0
      rotation: 0
      state: enabled
  - name: zeromq_pub_sink_iq
    id: zeromq_pub_sink
    parameters:
      address: '"tcp://127.0.0.1:5004"'
      affinity: ''
      alias: ''
      bind: 'True'
      comment: ''
      drop_on_hwm: 'True'
      hwm: '-1'
      key: ''
      pass_tags: 'False'
      timeout: '100'
      type: complex
      vlen: '1'
    states:
      bus_sink: false
      bus_source: false
      bus_structure:
      coordinate:
        - 200
        - 300.0
      rotation: 0
      state: enabled
connections:
  - [blocks_repack_bits_bb_1, '0', digital_crc32_bb_1, '0']
  - [digital_constellation_decoder_cb_1, '0', digital_diff_decoder_bb_0, '0']
  - [digital_correlate_access_code_xx_ts_0, '0', virtual_sink_4, '0']
  - [digital_costas_loop_cc_0, '0', virtual_sink_3, '0']
  - [digital_crc32_bb_1, '0', blocks_file_sink_0, '0']
  - [digital_crc32_bb_1, '0', pdu_tagged_stream_to_pdu_0, '0']
  - [digital_diff_decoder_bb_0, '0', digital_correlate_access_code_xx_ts_0, '0']
  - [digital_symbol_sync_xx_0, '0', digital_costas_loop_cc_0, '0']
  - [epy_block_0, msg_out, zeromq_push_msg_sink_0, in]
  - [filter_fft_rrc_filter_0, '0', digital_symbol_sync_xx_0, '0']
  - [pdu_tagged_stream_to_pdu_0, pdus, blocks_message_debug_0, print]
  - [pdu_tagged_stream_to_pdu_0, pdus, epy_block_0, pdu_in]
  - [soapy_rtlsdr_source_0, '0', filter_fft_rrc_filter_0, '0']
  - [virtual_source_2, '0', digital_constellation_decoder_cb_1, '0']
  - [virtual_source_3, '0', blocks_repack_bits_bb_1, '0']
  - [zeromq_sub_source_0, '0', filter_fft_rrc_filter_0, '0']
  -   - digital_costas_loop_cc_0
      - '0'
      - zeromq_pub_sink_iq
      - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
