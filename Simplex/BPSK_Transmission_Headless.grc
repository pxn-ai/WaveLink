      bus_source: false
      bus_structure:
      coordinate: [48, 240.0]
      rotation: 0
      state: enabled
  - name: snippet_0
    id: snippet
    parameters:
      alias: ''
      code: "with open(\"bpsk_transmit.txt\", \"w\") as f:\n\tpayload = \"Hello World!
        \\n \\t - from WaveLink\"\n\tf.write(payload)"
      comment: Create transmit file
      priority: '0'
