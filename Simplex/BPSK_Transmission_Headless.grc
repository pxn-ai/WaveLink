  - [blocks_vector_source_x_0_0, '0', blocks_stream_to_tagged_stream_0_0_0_0_0, '0']
  - [digital_constellation_modulator_0, '0', blocks_multiply_const_vxx_0, '0']
  - [digital_crc32_bb_0, '0', digital_protocol_formatter_bb_0, '0']
  - [digital_crc32_bb_0, '0', virtual_sink_2_0, '0']
  - [digital_protocol_formatter_bb_0, '0', virtual_sink_0_0, '0']
  - [epy_block_0, pdu_out, pdu_pdu_to_tagged_stream_0, pdus]
  - [pdu_pdu_to_tagged_stream_0, '0', digital_crc32_bb_0, '0']
  - [zeromq_pull_msg_source_0, out, epy_block_0, msg_in]
  - [virtual_source_5, '0', blocks_tagged_stream_mux_0, '1']
  - [virtual_source_6, '0', blocks_tagged_stream_mux_0, '2']
  -   - blocks_multiply_const_vxx_0
      - '0'
      - zeromq_pub_sink_iq
      - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
