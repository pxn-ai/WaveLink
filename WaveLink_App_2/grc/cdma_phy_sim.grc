- name: n1_ldpc_enc
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nLDPC Encoder\n\nForward error correction for the payload: the 5G NR LDPC code (3GPP TS 38.212,\nbase graph 1).  Each MAC frame + CRC-32 is one codeword: filler bits up to\n22 x Z (Z = smallest 5G lifting size that fits), systematic encoding, then rate\nmatching to the code rate the link layer asked for (1/2, 2/3, 3/4 or 5/6; the\nfirst 2 Z bits are punctured as in 5G) and the 5G bit interleaver for the\nmodulation.  An uncoded frame ('16qam', 'qpsk', 'bpsk') passes as plain bits.\n\nInput PDU:  frame bytes, metadata code, mod = modulation-and-coding ('16qam-3/4')\nOutput PDU: one byte per coded bit (0/1), metadata code, mod, rate, length\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the wavelink package importable (this file is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(), \"x\"))))\n    for\
      \ cand in (here, os.path.join(here, \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand, \"wavelink\")):\n            cand = os.path.abspath(cand)\n            if cand not in sys.path:\n                sys.path.insert(0, cand)\n            return True\n    return \"wavelink\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n        if _project():\n            from wavelink.grc_phy import register\n            register(node_id, role, obj)\n    except ImportError:\n        pass                     # opened in GNU Radio Companion outside the project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self, max_payload=1024):\n        gr.sync_block.__init__(self, name=\"LDPC Encoder\", in_sig=None, out_sig=None)\n        self.max_payload = int(max_payload)\n        self.port_in, self.port_out = pmt.intern(\"pdus\"), pmt.intern(\"pdus\")\n        self.message_port_register_in(self.port_in)\n\
      \        self.message_port_register_out(self.port_out)\n        self.set_msg_handler(self.port_in, self.handle)\n        self.core = None\n\n    def start(self):\n        _project()\n        from wavelink.grc_phy import LdpcEncoderCore, phy_config\n        self.core = LdpcEncoderCore(phy_config(4e6, 2, max_payload=self.max_payload))\n        return True\n\n    def handle(self, msg):\n        if self.core is None:\n            self.start()\n        meta, vec = pmt.car(msg), pmt.cdr(msg)\n        frame = bytes(pmt.u8vector_elements(vec))\n        mcs = pmt.symbol_to_string(pmt.dict_ref(meta, pmt.intern(\"mod\"), pmt.intern(\"qpsk-1/2\")))\n        bits, mod, rate = self.core.encode(frame, mcs)\n        meta = pmt.dict_add(meta, pmt.intern(\"mod\"), pmt.intern(mod))\n        meta = pmt.dict_add(meta, pmt.intern(\"rate\"), pmt.from_long(int(rate)))\n        meta = pmt.dict_add(meta, pmt.intern(\"length\"), pmt.from_long(len(frame)))\n        self.message_port_pub(self.port_out, pmt.cons(meta,\
      \ pmt.init_u8vector(len(bits), bits.tolist())))\n"
    max_payload: max_payload
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1088
    - 1020
    rotation: 0
    state: enabled
- name: n1_framer
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nCDMA PHY Framer\n\nBuilds one burst per PDU and outputs it as constellation *indices* (one byte per\nsymbol) for the Chunks-to-Symbols blocks of the code lanes:\n\n  preamble   48 known BPSK symbols, different for every Gold code (burst detection,\n             timing, carrier phase and frequency estimation at the receiver)\n  header     48 BPSK symbols: two Golay(24,12) codewords of 11-bit length,\n             2-bit modulation, 3-bit code rate, CRC-8\n  payload    the LDPC Encoder's bits, Gray-mapped to BPSK (index 0-1), QPSK (2-5)\n             or 16-QAM (6-21) of the combined symbol table\n\nOutput metadata 'code' selects the lane (spreading code) downstream.\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _project():\n    \"\"\"Make the wavelink package importable (this file is generated into grc/ or build/grc/).\"\"\"\n    here = os.path.dirname(os.path.abspath(globals().get(\"__file__\", os.path.join(os.getcwd(),\
      \ \"x\"))))\n    for cand in (here, os.path.join(here, \"..\"), os.path.join(here, \"..\", \"..\"),\n                 os.getcwd(), os.path.join(os.getcwd(), \"..\")):\n        if os.path.isdir(os.path.join(cand, \"wavelink\")):\n            cand = os.path.abspath(cand)\n            if cand not in sys.path:\n                sys.path.insert(0, cand)\n            return True\n    return \"wavelink\" in sys.modules\n\n\ndef _register(node_id, role, obj):\n    try:\n        if _project():\n            from wavelink.grc_phy import register\n            register(node_id, role, obj)\n    except ImportError:\n        pass                     # opened in GNU Radio Companion outside the project: ports only\n\n\nclass blk(gr.sync_block):\n    def __init__(self, gold_degree=5, preamble_bits=48, max_payload=1024):\n        gr.sync_block.__init__(self, name=\"CDMA PHY Framer\", in_sig=None, out_sig=None)\n        self.args = (int(gold_degree), int(preamble_bits), int(max_payload))\n        self.port_in,\
      \ self.port_out = pmt.intern(\"pdus\"), pmt.intern(\"pdus\")\n        self.message_port_register_in(self.port_in)\n        self.message_port_register_out(self.port_out)\n        self.set_msg_handler(self.port_in, self.handle)\n        self.core = None\n\n    def start(self):\n        _project()\n        from wavelink.grc_phy import FramerCore, phy_config\n        g, k, m = self.args\n        self.core = FramerCore(phy_config(4e6, 2, g, k, m))\n        return True\n\n    def handle(self, msg):\n        if self.core is None:\n            self.start()\n        meta, vec = pmt.car(msg), pmt.cdr(msg)\n        code = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"code\"), pmt.from_long(0)))\n        mod = pmt.symbol_to_string(pmt.dict_ref(meta, pmt.intern(\"mod\"), pmt.intern(\"bpskc\")))\n        rate = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"rate\"), pmt.from_long(0)))\n        length = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"length\"), pmt.from_long(0)))\n        bits = np.asarray(pmt.u8vector_elements(vec),\
      \ dtype=np.int8)\n        idx = self.core.indices(bits, length, code, mod, rate)\n        out = pmt.dict_add(pmt.make_dict(), pmt.intern(\"code\"), pmt.from_long(code))\n        self.message_port_pub(self.port_out, pmt.cons(out, pmt.init_u8vector(len(idx), idx.tolist())))\n"
    gold_degree: gold_degree
    preamble_bits: preamble_bits
    max_payload: max_payload
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 1570
    rotation: 0
